[Unit]
Description=OpenTUI persistent benchmark worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/repos/opentui-bench
EnvironmentFile=%h/.config/opentui-bench/worker.env
ExecStart=%h/.local/libexec/opentui-bench/run-benchmarks.sh --daemon
Restart=on-failure
RestartSec=60
TimeoutStopSec=30
KillSignal=SIGTERM

[Install]
WantedBy=default.target
